{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "lint",
    "e2e",
    "bench",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.bench.config.ts"
  ],
  // The service worker's own script has the types of a worker, not of a
  // page (tsconfig.sw.json).
  "exclude": ["src/sw/sw.ts"]
}
