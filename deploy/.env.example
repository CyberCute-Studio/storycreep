# Settings for docker-compose.yml. Copy this file to .env next to
# docker-compose.yml, where Docker Compose reads it, and set
# POSTGRES_PASSWORD. Everything else is optional.

# Required. The password of the database's superuser, postgres, which applies
# the migrations, and of the server's own logins, storycreep and
# storycreep_maintainer. Make one with
#   openssl rand -hex 32
# Docker Compose expands a $ in this file, so a password with one goes in
# single quotes. The database takes the password when it is created, the
# first time it starts, and keeps it afterwards: see README.md to change it.
POSTGRES_PASSWORD=

# The image to run. Until the first release, it is the latest build of the
# main branch.
#STORYCREEP_IMAGE=ghcr.io/cybercute-studio/storycreep:main

# Where Docker publishes the server's HTTP port, as [address:]port. The
# default reaches it from this machine only, as a reverse proxy on it does
# (README.md says how a proxy in a container reaches the server instead);
# 0.0.0.0:7777 reaches it from every network this machine is on, over plain
# HTTP, and so does a port without an address, such as 8000. To change only
# the port, keep the address, as in 127.0.0.1:8000, and set
# STORYCREEP_PUBLIC_URL below to the URL with that port.
#STORYCREEP_PUBLISH=127.0.0.1:7777

# The URL users open Storycreep at. Behind a reverse proxy that terminates
# TLS, it is the proxy's https URL.
#STORYCREEP_PUBLIC_URL=http://localhost:7777

# The server's other settings, which docs/configuration.md in the Storycreep
# repository describes. Left empty, a setting takes the server's default.
#STORYCREEP_MODE=self-hosted
#STORYCREEP_PUBLIC_SITE=
#STORYCREEP_SIGNUP=
#STORYCREEP_INSTANCE_ADMIN_ACCESS=
#STORYCREEP_SESSION_IDLE_TIMEOUT=
#STORYCREEP_SESSION_LIFETIME=
#STORYCREEP_DEFAULT_LOCALE=
#STORYCREEP_LOG_LEVEL=

# /metrics is served on the admin port, which listens inside the container
# only, unless it is set to :9090, which lets a Prometheus on the compose
# network scrape app:9090. Set a token to require it from the scraper.
#STORYCREEP_ADMIN_ADDR=
#STORYCREEP_METRICS_TOKEN=

# The Compose project's name, which the containers' and the volumes' names
# start with, whatever directory docker-compose.yml is in. Every copy with
# the same name runs the same instance, on the same volumes, so a second
# instance on this machine needs a name of its own, set before its first
# start, and a STORYCREEP_PUBLISH port of its own. Changing the name later
# starts a new, empty instance.
#COMPOSE_PROJECT_NAME=storycreep
