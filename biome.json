{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.gen.ts", "!schema/api/v1/openapi.json"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "web/app/src/**",
        "web/site/src/**",
        "web/shared/src/**",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "plugins": ["./web/shared/lint/hardcoded-text.grit"]
    }
  ]
}
