    { "key": "members", "billable": true },
    { "key": "projects" },
    { "key": "storage_bytes" },
    { "key": "snapshot_retention", "inert_until": "FR-SNAP-06" }
  ],
  "features": ["collaboration", "sso", "audit_export"],
  "plans": [
    {
      "key": "unlimited",
      "limits": {
        "members": "unlimited",
        "projects": "unlimited",
        "storage_bytes": "unlimited",
        "snapshot_retention": "unlimited"
      },
      "features": { "collaboration": true, "sso": true, "audit_export": true }
    },
    {
      "key": "free",
      "limits": {
