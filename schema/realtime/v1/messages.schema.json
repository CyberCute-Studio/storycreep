{
  "$defs": {
    "ClientMessage": {
      "description": "A message that a client sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/SubscribeMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribeMessage"
        }
      ]
    },
    "ErrorMessage": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "description": "invalid_message: the message is not a JSON object of one of the client's types, with their fields",
          "enum": [
            "invalid_message"
          ],
          "type": "string"
        },
        "type": {
          "description": "error",
          "enum": [
            "error"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "code"
      ],
      "type": "object"
    },
    "HeartbeatMessage": {
      "additionalProperties": true,
      "properties": {
        "type": {
          "description": "heartbeat",
          "enum": [
            "heartbeat"
          ],
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "OperationCommand": {
      "additionalProperties": true,
      "properties": {
        "command_id": {
          "description": "The command's ID, which its client gave it",
          "format": "uuid",
          "type": "string"
        },
        "payload": {
          "description": "The command's payload, as the command endpoint's document describes it for the type"
        },
        "type": {
          "description": "The command's type, as node.create",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "type",
        "payload"
      ],
      "type": "object"
    },
    "OperationMessage": {
      "additionalProperties": true,
      "properties": {
        "commands": {
          "description": "The batch's commands, in the order that they applied",
          "items": {
            "$ref": "#/$defs/OperationCommand"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "created_at": {
          "description": "When the batch applied",
          "format": "date-time",
          "type": "string"
        },
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "revisions": {
          "description": "The entities that the batch changed, each with its revision after the batch",
          "items": {
            "$ref": "#/$defs/OperationRevision"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "seq": {
          "description": "The batch's seq, the next of the project's",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "operation",
          "enum": [
            "operation"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id",
        "seq",
        "commands",
        "revisions",
        "created_at"
      ],
      "type": "object"
    },
    "OperationRevision": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "description": "The entity's ID, as nd_…",
          "type": "string"
        },
        "rev": {
          "description": "The entity's revision after the batch",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "rev"
      ],
      "type": "object"
    },
    "ResyncRequiredMessage": {
      "additionalProperties": true,
      "properties": {
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "seq": {
          "description": "The seq that the subscription goes on from: the operations after it follow",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "resync_required",
          "enum": [
            "resync_required"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id",
        "seq"
      ],
      "type": "object"
    },
    "ServerMessage": {
      "description": "A message that the server sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/SubscribedMessage"
        },
        {
          "$ref": "#/$defs/ResyncRequiredMessage"
        },
        {
          "$ref": "#/$defs/OperationMessage"
        },
        {
          "$ref": "#/$defs/UnsubscribedMessage"
        },
        {
          "$ref": "#/$defs/SubscriptionFailedMessage"
        },
        {
          "$ref": "#/$defs/ErrorMessage"
        },
        {
          "$ref": "#/$defs/HeartbeatMessage"
        }
      ]
    },
    "SubscribeMessage": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "since": {
          "description": "The seq of the project's latest operation that the client has, 0 for none: the operations after it are sent first. Without it, only those that commit from now on are.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "subscribe",
          "enum": [
            "subscribe"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id"
      ],
      "type": "object"
    },
    "SubscribedMessage": {
      "additionalProperties": true,
      "properties": {
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "seq": {
          "description": "The seq of the project's latest operation when the subscription started: those after since, up to it, follow first",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "subscribed",
          "enum": [
            "subscribed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id",
        "seq"
      ],
      "type": "object"
    },
    "SubscriptionFailedMessage": {
      "additionalProperties": true,
      "properties": {
        "code": {
          "description": "invalid_id, the ID is not a project's; not_found, there is no such project, or the user cannot read it, which the answer does not tell apart; rate_limited, the user has subscribed too often, and retries after retry_after seconds; or too_many_subscriptions, the socket subscribes to 100 projects already",
          "enum": [
            "invalid_id",
            "not_found",
            "rate_limited",
            "too_many_subscriptions"
          ],
          "type": "string"
        },
        "project_id": {
          "description": "The project's ID as the subscription named it",
          "type": "string"
        },
        "retry_after": {
          "description": "For rate_limited, how many seconds to wait before subscribing again",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "description": "subscription_failed",
          "enum": [
            "subscription_failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id",
        "code"
      ],
      "type": "object"
    },
    "UnsubscribeMessage": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "type": {
          "description": "unsubscribe",
          "enum": [
            "unsubscribe"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id"
      ],
      "type": "object"
    },
    "UnsubscribedMessage": {
      "additionalProperties": true,
      "properties": {
        "project_id": {
          "description": "The project's ID, as prj_…",
          "type": "string"
        },
        "reason": {
          "description": "requested, as the client asked, or not_found, the project can no longer be read",
          "enum": [
            "requested",
            "not_found"
          ],
          "type": "string"
        },
        "type": {
          "description": "unsubscribed",
          "enum": [
            "unsubscribed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "project_id",
        "reason"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/CyberCute-Studio/storycreep/main/schema/realtime/v1/messages.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The messages of the WebSocket of GET /api/v1/ws (PRD FR-RT-01): each a JSON object in a text message of its own, whose type its type field names. A client subscribes to the projects that it reads, and is sent the operations of each that it missed, and then each that commits, in the order of their seqs.",
  "oneOf": [
    {
      "$ref": "#/$defs/ClientMessage"
    },
    {
      "$ref": "#/$defs/ServerMessage"
    }
  ],
  "title": "Storycreep real-time messages, version 1"
}
