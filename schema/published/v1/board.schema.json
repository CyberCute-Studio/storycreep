{
  "$defs": {
    "ASTAssign": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "An assignment, with its operator as its source writes it.",
      "properties": {
        "kind": {
          "const": "assign"
        },
        "op": {
          "enum": [
            "%=",
            "*=",
            "+=",
            "-=",
            "/=",
            "="
          ],
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ASTTarget"
        },
        "value": {
          "$ref": "#/$defs/ASTExpression"
        }
      },
      "required": [
        "kind",
        "op",
        "target",
        "value"
      ],
      "type": "object"
    },
    "ASTAttr": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A component's runtime attribute.",
      "properties": {
        "attribute": {
          "$ref": "#/$defs/AttributeDefId"
        },
        "kind": {
          "const": "attr"
        },
        "name": {
          "description": "<component_key>.<attribute_key>, for readability: the AST names the attribute by its ref, the component's ID, and its attribute, the attribute definition's.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}\\.[A-Za-z_][A-Za-z0-9_]{0,63}$",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/ComponentId"
        }
      },
      "required": [
        "attribute",
        "kind",
        "name",
        "ref"
      ],
      "type": "object"
    },
    "ASTBinary": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A binary operator applied to its operands, left and right.",
      "properties": {
        "kind": {
          "const": "binary"
        },
        "left": {
          "$ref": "#/$defs/ASTExpression"
        },
        "op": {
          "enum": [
            "add",
            "and",
            "div",
            "eq",
            "gt",
            "gte",
            "lt",
            "lte",
            "mod",
            "mul",
            "ne",
            "or",
            "sub"
          ],
          "type": "string"
        },
        "right": {
          "$ref": "#/$defs/ASTExpression"
        }
      },
      "required": [
        "kind",
        "left",
        "op",
        "right"
      ],
      "type": "object"
    },
    "ASTBool": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A literal of the type bool.",
      "properties": {
        "kind": {
          "const": "lit"
        },
        "type": {
          "const": "bool"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "type",
        "value"
      ],
      "type": "object"
    },
    "ASTCall": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A call of a function.",
      "properties": {
        "args": {
          "description": "The arguments, in order, [] for none.",
          "items": {
            "$ref": "#/$defs/ASTExpression"
          },
          "maxItems": 8,
          "type": "array"
        },
        "function": {
          "description": "The function's name. A runtime refuses at load a name that it does not know (PRD §6.4).",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "kind": {
          "const": "call"
        }
      },
      "required": [
        "args",
        "function",
        "kind"
      ],
      "type": "object"
    },
    "ASTExpression": {
      "description": "The AST of an expression: a condition's, an operand, a call's argument, or an assignment's value.",
      "oneOf": [
        {
          "$ref": "#/$defs/ASTBool"
        },
        {
          "$ref": "#/$defs/ASTInt"
        },
        {
          "$ref": "#/$defs/ASTFloat"
        },
        {
          "$ref": "#/$defs/ASTString"
        },
        {
          "$ref": "#/$defs/ASTVar"
        },
        {
          "$ref": "#/$defs/ASTAttr"
        },
        {
          "$ref": "#/$defs/ASTNodeRef"
        },
        {
          "$ref": "#/$defs/ASTUnary"
        },
        {
          "$ref": "#/$defs/ASTBinary"
        },
        {
          "$ref": "#/$defs/ASTCall"
        }
      ]
    },
    "ASTFloat": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A literal of the type float.",
      "properties": {
        "kind": {
          "const": "lit"
        },
        "type": {
          "const": "float"
        },
        "value": {
          "maximum": 1.7976931348623157e+308,
          "minimum": -1.7976931348623157e+308,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "type",
        "value"
      ],
      "type": "object"
    },
    "ASTInt": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A literal of the type int.",
      "properties": {
        "kind": {
          "const": "lit"
        },
        "type": {
          "const": "int"
        },
        "value": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "type",
        "value"
      ],
      "type": "object"
    },
    "ASTNodeRef": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A node reference literal, node(\"nd_…\") (§5.8.4).",
      "properties": {
        "kind": {
          "const": "node_ref"
        },
        "ref": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    },
    "ASTScript": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "The AST of a script: its statements, in order.",
      "properties": {
        "kind": {
          "const": "script"
        },
        "statements": {
          "description": "The script's statements, in order, [] for none.",
          "items": {
            "$ref": "#/$defs/ASTStatement"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "statements"
      ],
      "type": "object"
    },
    "ASTStatement": {
      "description": "A statement of a script: an assignment or a call.",
      "oneOf": [
        {
          "$ref": "#/$defs/ASTAssign"
        },
        {
          "$ref": "#/$defs/ASTCall"
        }
      ]
    },
    "ASTString": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A literal of the type string.",
      "properties": {
        "kind": {
          "const": "lit"
        },
        "type": {
          "const": "string"
        },
        "value": {
          "maxLength": 4096,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "type",
        "value"
      ],
      "type": "object"
    },
    "ASTTarget": {
      "description": "What an assignment assigns to: a variable or a component's runtime attribute.",
      "oneOf": [
        {
          "$ref": "#/$defs/ASTVar"
        },
        {
          "$ref": "#/$defs/ASTAttr"
        }
      ]
    },
    "ASTUnary": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A unary operator, not (!) or neg (-), applied to its operand.",
      "properties": {
        "kind": {
          "const": "unary"
        },
        "op": {
          "enum": [
            "neg",
            "not"
          ],
          "type": "string"
        },
        "operand": {
          "$ref": "#/$defs/ASTExpression"
        }
      },
      "required": [
        "kind",
        "op",
        "operand"
      ],
      "type": "object"
    },
    "ASTVar": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A variable.",
      "properties": {
        "kind": {
          "const": "var"
        },
        "name": {
          "description": "The variable's key, for readability: the AST names the variable by its ref.",
          "maxLength": 64,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/VariableId"
        }
      },
      "required": [
        "kind",
        "name",
        "ref"
      ],
      "type": "object"
    },
    "AnyValue": {
      "description": "Any JSON value but null, at any depth: what an object may hold of a property that this version of the format does not define, which a consumer ignores (PRD §6.4).",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/AnyValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AnyValue"
          },
          "type": "object"
        }
      ]
    },
    "AssetId": {
      "description": "An asset's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^ast_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "AttributeDefId": {
      "description": "An attribute definition's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^atr_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Board": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A snapshot's file of one board, boards/<slug>.json: the board, its nodes, and its connections (PRD §6.3, §6.5).",
      "properties": {
        "board": {
          "$ref": "#/$defs/BoardInfo"
        },
        "connections": {
          "description": "The board's connections, sorted by ID.",
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "type": "array"
        },
        "nodes": {
          "description": "The board's nodes, sorted by ID.",
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "schemaVersion": {
          "const": 1,
          "description": "The version of the published format, 1.",
          "type": "integer"
        }
      },
      "required": [
        "board",
        "connections",
        "nodes",
        "schemaVersion"
      ],
      "type": "object"
    },
    "BoardId": {
      "description": "A board's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^bd_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "BoardInfo": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "The board: its ID, name, slug, and entry node, as the manifest's index has them.",
      "properties": {
        "entryNodeId": {
          "$ref": "#/$defs/NodeId",
          "description": "The board's entry node. Without it, the board has none, which only a draft may lack."
        },
        "id": {
          "$ref": "#/$defs/BoardId"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "slug"
      ],
      "type": "object"
    },
    "Branch": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A branch, which picks the first of its outputs whose condition holds (FR-EDIT-04).",
      "properties": {
        "cover": false,
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "isEnding": false,
        "kind": false,
        "onEnter": {
          "$ref": "#/$defs/Script",
          "description": "The script that runs when the flow enters the branch. Without it, none."
        },
        "onExit": {
          "$ref": "#/$defs/Script",
          "description": "The script that runs when the flow leaves the branch. Without it, none."
        },
        "outputs": {
          "description": "The branch's outputs, in their author's order, which is the order in which their conditions are evaluated, [] for none.",
          "items": {
            "$ref": "#/$defs/BranchOutput"
          },
          "type": "array"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "speaker": false,
        "tags": false,
        "target": false,
        "text": false,
        "title": {
          "description": "The branch's title. Without it, the branch has none.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "branch"
        }
      },
      "required": [
        "id",
        "outputs",
        "position",
        "type"
      ],
      "type": "object"
    },
    "BranchOutput": {
      "description": "An output of a branch: if or elseif, with a condition, or else, without one (FR-EDIT-04). The connections that leave it name it as their fromPort.",
      "oneOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/AnyValue"
          },
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition",
              "description": "The condition that picks the output."
            },
            "id": {
              "$ref": "#/$defs/BranchOutputId"
            },
            "kind": {
              "const": "if"
            },
            "order": {
              "description": "The output's place among its branch's, from 0.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "condition",
            "id",
            "kind",
            "order"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AnyValue"
          },
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition",
              "description": "The condition that picks the output."
            },
            "id": {
              "$ref": "#/$defs/BranchOutputId"
            },
            "kind": {
              "const": "elseif"
            },
            "order": {
              "description": "The output's place among its branch's, from 0.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "condition",
            "id",
            "kind",
            "order"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AnyValue"
          },
          "properties": {
            "condition": false,
            "id": {
              "$ref": "#/$defs/BranchOutputId"
            },
            "kind": {
              "const": "else"
            },
            "order": {
              "description": "The output's place among its branch's, from 0.",
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "kind",
            "order"
          ],
          "type": "object"
        }
      ]
    },
    "BranchOutputId": {
      "description": "A branch output's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^bo_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "ComponentId": {
      "description": "A component's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^cmp_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Condition": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A condition: its source, and its AST, an expression, whose names are resolved to the IDs of what they name (PRD §5.8.5, §5.8.8).",
      "properties": {
        "ast": {
          "$ref": "#/$defs/ASTExpression"
        },
        "source": {
          "description": "The source, as its author wrote it, for debugging: a runtime evaluates the AST, and parses no source (PRD §6.1).",
          "type": "string"
        }
      },
      "required": [
        "ast",
        "source"
      ],
      "type": "object"
    },
    "Connection": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A connection of a board, from a node's port to a node of the board (FR-EDIT-03).",
      "properties": {
        "condition": {
          "$ref": "#/$defs/Condition",
          "description": "The condition that makes the connection a choice. Without it, the connection always is."
        },
        "from": {
          "$ref": "#/$defs/NodeId",
          "description": "The node that the connection leaves: an element, or a branch by one of its outputs."
        },
        "fromPort": {
          "description": "The port that the connection leaves its node by: an element's out, or the ID of a branch's output.",
          "pattern": "^(?:out|bo_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25})$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/ConnectionId"
        },
        "label": {
          "$ref": "#/$defs/Label",
          "description": "The connection's label, the text of its choice. Without it, the connection has none."
        },
        "onTraverse": {
          "$ref": "#/$defs/Script",
          "description": "The script that runs when the flow traverses the connection. Without it, none."
        },
        "order": {
          "description": "The connection's place among those that leave its port, from 0, the order of its choice.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "$ref": "#/$defs/NodeId",
          "description": "The node of the board that the connection leads to."
        }
      },
      "required": [
        "from",
        "fromPort",
        "id",
        "order",
        "to"
      ],
      "type": "object"
    },
    "ConnectionId": {
      "description": "A connection's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^cn_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Element": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "An element: a line of dialogue or of narration (FR-EDIT-02).",
      "properties": {
        "cover": {
          "$ref": "#/$defs/AssetId",
          "description": "The element's cover image. Its file is the snapshot's assets/<the ID's body>.<its extension> when the snapshot includes assets. Without it, the element has none."
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "isEnding": {
          "description": "Whether the flow ends at the element (PRD §5.8.5).",
          "type": "boolean"
        },
        "kind": {
          "description": "Dialogue, which its speaker says, or narration.",
          "enum": [
            "dialogue",
            "narration"
          ],
          "type": "string"
        },
        "onEnter": {
          "$ref": "#/$defs/Script",
          "description": "The script that runs when the flow enters the element. Without it, none."
        },
        "onExit": {
          "$ref": "#/$defs/Script",
          "description": "The script that runs when the flow leaves the element, by a connection or by ending there. Without it, none."
        },
        "outputs": false,
        "position": {
          "$ref": "#/$defs/Position"
        },
        "speaker": {
          "$ref": "#/$defs/ComponentId",
          "description": "The component that says a line of dialogue. Without it, the element has none."
        },
        "tags": {
          "description": "The element's tags, as their author wrote them, in their order, no two the same but for their case. Without them, none.",
          "items": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "target": false,
        "text": {
          "$ref": "#/$defs/Text",
          "description": "The element's text. Without it, the element's text is empty."
        },
        "title": {
          "description": "The element's title. Without it, the element has none.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "element"
        }
      },
      "required": [
        "id",
        "isEnding",
        "kind",
        "position",
        "type"
      ],
      "type": "object"
    },
    "Jumper": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A jumper, which continues the flow at its target, as if the flow had reached the target itself (PRD §5.8.5).",
      "properties": {
        "cover": false,
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "isEnding": false,
        "kind": false,
        "onEnter": false,
        "onExit": false,
        "outputs": false,
        "position": {
          "$ref": "#/$defs/Position"
        },
        "speaker": false,
        "tags": false,
        "target": {
          "$ref": "#/$defs/JumperTarget",
          "description": "The node that the jumper continues the flow at. Without it, the jumper has none, which only a draft may lack."
        },
        "text": false,
        "title": {
          "description": "The jumper's title. Without it, the jumper has none.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "jumper"
        }
      },
      "required": [
        "id",
        "position",
        "type"
      ],
      "type": "object"
    },
    "JumperTarget": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "The node that a jumper continues the flow at, and its board.",
      "properties": {
        "boardId": {
          "$ref": "#/$defs/BoardId",
          "description": "The node's board, which may be the jumper's own."
        },
        "nodeId": {
          "$ref": "#/$defs/NodeId",
          "description": "A node of the board, which is no jumper."
        }
      },
      "required": [
        "boardId",
        "nodeId"
      ],
      "type": "object"
    },
    "Label": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A connection's label, the text of its choice: its segments, at least one.",
      "properties": {
        "segments": {
          "description": "The rich text's segments, in order, at least one: an empty rich text is left out.",
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "segments"
      ],
      "type": "object"
    },
    "Node": {
      "description": "A node of a board: an element, a branch, or a jumper, which its type tells (FR-EDIT-02).",
      "oneOf": [
        {
          "$ref": "#/$defs/Element"
        },
        {
          "$ref": "#/$defs/Branch"
        },
        {
          "$ref": "#/$defs/Jumper"
        }
      ]
    },
    "NodeId": {
      "description": "A node's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^nd_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Position": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "Where the node is on its board's canvas, to 2 decimal places (PRD §6.2).",
      "properties": {
        "x": {
          "description": "Rightward, in units of the canvas.",
          "maximum": 1000000000,
          "minimum": -1000000000,
          "type": "number"
        },
        "y": {
          "description": "Downward, in units of the canvas.",
          "maximum": 1000000000,
          "minimum": -1000000000,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "Script": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A script: its source, and its AST, a script node, whose names are resolved to the IDs of what they name (PRD §5.8.5, §5.8.8).",
      "properties": {
        "ast": {
          "$ref": "#/$defs/ASTScript"
        },
        "source": {
          "description": "The source, as its author wrote it, for debugging: a runtime evaluates the AST, and parses no source (PRD §6.1).",
          "type": "string"
        }
      },
      "required": [
        "ast",
        "source"
      ],
      "type": "object"
    },
    "Segment": {
      "description": "A segment of a rich text.",
      "oneOf": [
        {
          "$ref": "#/$defs/SegmentText"
        },
        {
          "$ref": "#/$defs/SegmentMention"
        },
        {
          "$ref": "#/$defs/SegmentVariable"
        },
        {
          "$ref": "#/$defs/SegmentAttribute"
        },
        {
          "$ref": "#/$defs/SegmentBreak"
        },
        {
          "$ref": "#/$defs/SegmentParagraph"
        },
        {
          "$ref": "#/$defs/SegmentBulletItem"
        },
        {
          "$ref": "#/$defs/SegmentOrderedItem"
        }
      ]
    },
    "SegmentAttribute": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
