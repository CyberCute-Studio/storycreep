        "kind": {
          "const": "text"
        },
        "marks": {
          "$ref": "#/$defs/SegmentMarks"
        },
        "value": {
          "description": "The text.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "marks",
        "value"
      ],
      "type": "object"
    },
    "SegmentVariable": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A variable's value, which the text shows as the runtime renders it (FR-TEXT-02).",
      "properties": {
        "attribute": false,
        "decimals": {
          "description": "The number of digits after the point that a number is shown with, rounded half away from zero. A value that is not a number is shown as it is.",
          "maximum": 6,
          "minimum": 0,
          "type": "integer"
        },
        "href": {
          "description": "The URL of the link that the segment is part of.",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(?:[Hh][Tt][Tt][Pp][Ss]?://[^\\x00-\\x20\\x7f-\\x9f/?#][^\\x00-\\x20\\x7f-\\x9f]*|[Mm][Aa][Ii][Ll][Tt][Oo]:[A-Za-z0-9_+-]+(?:\\.[A-Za-z0-9_+-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)*(?:[0-9]*[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?|[0-9]+-[A-Za-z0-9-]*[A-Za-z0-9]))$",
          "type": "string"
        },
        "kind": {
          "const": "value"
        },
        "marks": {
          "$ref": "#/$defs/SegmentMarks"
        },
        "name": {
          "description": "The value's name as an expression names it, as met_elara or elara.trust, for debugging: the segment reads the value by its ref.",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/VariableId"
        }
      },
      "required": [
        "kind",
        "marks",
        "name",
        "ref"
      ],
      "type": "object"
    },
    "Text": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "An element's text: its segments, at least one, and its preview (PRD §6.5).",
      "properties": {
        "preview": {
          "description": "The text's plain text as one line, cut after 100 characters with an ellipsis, as schema/rich-text/README.md says.",
          "type": "string"
