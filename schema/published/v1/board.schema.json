      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "SegmentBulletItem": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "An item of a bulleted list begins.",
      "properties": {
        "depth": {
          "description": "The item's depth, 1 for an item of a list that no list holds.",
