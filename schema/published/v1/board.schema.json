        "number": {
          "description": "The item's number.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "depth",
        "kind",
        "list",
        "number"
      ],
      "type": "object"
    },
    "SegmentParagraph": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A paragraph begins.",
      "properties": {
        "depth": {
          "description": "The depth of the list item that the paragraph belongs to, or none for a paragraph of no item.",
