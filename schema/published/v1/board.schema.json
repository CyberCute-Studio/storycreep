          "bold",
          "code",
          "italic",
          "link",
          "strike"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "SegmentMention": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A mention of a component.",
      "properties": {
        "href": {
          "description": "The URL of the link that the segment is part of.",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(?:[Hh][Tt][Tt][Pp][Ss]?://[^\\x00-\\x20\\x7f-\\x9f/?#][^\\x00-\\x20\\x7f-\\x9f]*|[Mm][Aa][Ii][Ll][Tt][Oo]:[A-Za-z0-9_+-]+(?:\\.[A-Za-z0-9_+-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)*(?:[0-9]*[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?|[0-9]+-[A-Za-z0-9-]*[A-Za-z0-9]))$",
          "type": "string"
        },
        "kind": {
          "const": "mention"
        },
        "marks": {
          "$ref": "#/$defs/SegmentMarks"
        },
        "ref": {
          "$ref": "#/$defs/ComponentId"
        },
        "value": {
          "description": "The component's name when the snapshot was published.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "marks",
        "ref",
        "value"
      ],
      "type": "object"
    },
    "SegmentOrderedItem": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "An item of a numbered list begins.",
      "properties": {
        "depth": {
          "description": "The item's depth, 1 for an item of a list that no list holds.",
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "const": "item"
        },
        "list": {
          "const": "ordered"
