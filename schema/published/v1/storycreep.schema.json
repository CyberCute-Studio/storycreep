{
  "$defs": {
    "AnyValue": {
      "description": "Any JSON value but null, at any depth: what an object may hold of a property that this version of the format does not define, which a consumer ignores (PRD §6.4).",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/AnyValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/AnyValue"
          },
          "type": "object"
        }
      ]
    },
    "BoardId": {
      "description": "A board's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^bd_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Counts": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "How many of each entity the snapshot holds.",
      "properties": {
        "boards": {
          "minimum": 0,
          "type": "integer"
        },
        "components": {
          "minimum": 0,
          "type": "integer"
        },
        "connections": {
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "description": "The nodes of every type: elements, branches, and jumpers.",
          "minimum": 0,
          "type": "integer"
        },
        "variables": {
          "description": "The variables, global and of each board.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "boards",
        "components",
        "connections",
        "nodes",
        "variables"
      ],
      "type": "object"
    },
    "DraftSnapshot": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "The working draft, as it was when it was pulled, which has neither an ID nor a version (PRD §7.8).",
      "properties": {
        "channel": {
          "const": "draft"
        },
        "contentHash": {
          "$ref": "#/$defs/Hash",
          "description": "The hash of the draft's content when it was pulled."
        },
        "id": false,
        "note": false,
        "publishedAt": false,
        "pulledAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "version": false
      },
      "required": [
        "channel",
        "contentHash",
        "pulledAt"
      ],
      "type": "object"
    },
    "Entry": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "Where the flow starts: a node, and its board.",
      "properties": {
        "boardId": {
          "$ref": "#/$defs/BoardId"
        },
        "nodeId": {
          "$ref": "#/$defs/NodeId",
          "description": "A node of the board."
        }
      },
      "required": [
        "boardId",
        "nodeId"
      ],
      "type": "object"
    },
    "GeneratorInfo": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "What wrote the snapshot.",
      "properties": {
        "name": {
          "description": "What wrote the snapshot, storycreep for the server.",
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "description": "Its version.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Hash": {
      "description": "sha256: and the lowercase hexadecimal SHA-256 of the bytes.",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "Manifest": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A snapshot's manifest, storycreep.json: what the snapshot is, its boards, and the hash of each of its files (PRD §6.3, §6.5).",
      "properties": {
        "astVersion": {
          "description": "The highest ast_version among the constructs that the snapshot's expressions use, 1 for none (FR-EXPR-04). A runtime that supports a lower one refuses the snapshot (PRD §6.4).",
          "minimum": 1,
          "type": "integer"
        },
        "boards": {
          "description": "Every board, sorted by ID, by which a runtime finds a board's file without reading any other board's (PRD §6.5).",
          "items": {
            "$ref": "#/$defs/ManifestBoard"
          },
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "entry": {
          "$ref": "#/$defs/Entry",
          "description": "Where the flow starts: the project's entry node, of its entry board. Without it, the project has none, which only a draft may lack."
        },
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/Hash"
          },
          "description": "The hash of each of the snapshot's files but the manifest, by its path, which uses forward slashes.",
          "propertyNames": {
            "pattern": "^(?:project/(?:settings|variables|component_types|components)\\.json|boards/[a-z0-9]+(?:-[a-z0-9]+)*\\.json|assets/[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}\\.(?:png|jpg|webp|gif|svg))$"
          },
          "type": "object"
        },
        "generator": {
          "$ref": "#/$defs/GeneratorInfo"
        },
        "project": {
          "$ref": "#/$defs/ProjectInfo"
        },
        "schemaVersion": {
          "const": 1,
          "description": "The version of the published format, 1.",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        }
      },
      "required": [
        "astVersion",
        "boards",
        "counts",
        "files",
        "generator",
        "project",
        "schemaVersion",
        "snapshot"
      ],
      "type": "object"
    },
    "ManifestBoard": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A board of the manifest's index: its ID, slug, name, entry node, and file.",
      "properties": {
        "entryNodeId": {
          "$ref": "#/$defs/NodeId",
          "description": "The board's entry node, where the flow enters the board when it starts there. Without it, the board has none, which only a draft may lack."
        },
        "file": {
          "description": "The path of the board's file, boards/ and its slug and .json, which the manifest's files list too.",
          "pattern": "^boards/[a-z0-9]+(?:-[a-z0-9]+)*\\.json$",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/BoardId"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "file",
        "id",
        "name",
        "slug"
      ],
      "type": "object"
    },
    "NodeId": {
      "description": "A node's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^nd_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "ProjectId": {
      "description": "A project's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^prj_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "ProjectInfo": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "The snapshot's project.",
      "properties": {
        "id": {
          "$ref": "#/$defs/ProjectId"
        },
        "name": {
          "type": "string"
        },
        "slug": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "slug"
      ],
      "type": "object"
    },
    "ReleaseSnapshot": {
      "additionalProperties": {
        "$ref": "#/$defs/AnyValue"
      },
      "description": "A published release.",
      "properties": {
        "channel": {
          "const": "release"
        },
        "contentHash": {
          "$ref": "#/$defs/Hash",
          "description": "The hash of the snapshot's content."
        },
        "id": {
          "$ref": "#/$defs/SnapshotId"
        },
        "note": {
          "description": "The note that the release was published with.",
          "type": "string"
        },
        "publishedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "pulledAt": false,
        "version": {
          "description": "The release's version, which its author chose.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "channel",
        "contentHash",
        "id",
        "note",
        "publishedAt",
        "version"
      ],
      "type": "object"
    },
    "Snapshot": {
      "description": "What the snapshot is: a published release, or the working draft as it was when it was pulled, which its channel tells (PRD §7.8).",
      "oneOf": [
        {
          "$ref": "#/$defs/ReleaseSnapshot"
        },
        {
          "$ref": "#/$defs/DraftSnapshot"
        }
      ]
    },
    "SnapshotId": {
      "description": "A snapshot's ID, in its canonical spelling (PRD §5.2).",
      "pattern": "^snp_[01234567][0123456789ABCDEFGHJKMNPQRSTVWXYZ]{25}$",
      "type": "string"
    },
    "Timestamp": {
      "description": "A moment, in UTC, to the second (RFC 3339), as 2026-10-12T18:04:31Z.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/CyberCute-Studio/storycreep/main/schema/published/v1/storycreep.schema.json",
  "$ref": "#/$defs/Manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A snapshot's manifest, storycreep.json, at the root of the snapshot's files (PRD §6.3, §6.5). schema/published/README.md describes the format.",
