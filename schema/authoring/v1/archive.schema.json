          "description": "Their display name, as it was when the archive was made.",
          "type": "string"
        },
        "id": {
          "description": "The user's ID.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName"
      ],
      "type": "object"
    },
    "PlayState": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "description": "When it was saved.",
          "format": "date-time",
          "type": "string"
        },
        "createdBy": {
          "description": "Who saved it, whom people.json names.",
          "type": "string"
        },
        "id": {
          "description": "The play state's ID.",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "names": {
          "description": "The names of the state's values, as play mode named them when it saved the state."
        },
        "state": {
          "description": "The save state, as schema/save-state defines it."
        }
      },
      "required": [
        "id",
        "name",
        "state",
        "names",
        "createdAt"
      ],
      "type": "object"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "description": "The project's description.",
          "type": "string"
        },
        "name": {
          "description": "The project's name.",
          "type": "string"
        },
        "settings": {
          "description": "The project's settings."
        },
        "slug": {
          "description": "The project's slug.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "slug",
        "description",
        "settings"
      ],
      "type": "object"
    },
    "Release": {
      "additionalProperties": false,
      "properties": {
        "builtAt": {
          "description": "When its build ended.",
          "format": "date-time",
          "type": "string"
        },
        "contentHash": {
          "description": "Its content hash.",
          "type": "string"
        },
        "counts": {
          "description": "Its manifest's entity counts."
        },
        "id": {
          "description": "The snapshot's ID.",
          "type": "string"
        },
        "note": {
          "description": "Its changelog note.",
          "type": "string"
        },
        "path": {
          "description": "The directory of its files in the archive.",
          "type": "string"
        },
        "publishedAt": {
          "description": "When it was published.",
          "format": "date-time",
          "type": "string"
        },
        "publishedBy": {
          "description": "Who published it, of a full archive alone, whom people.json names.",
          "type": "string"
        },
        "schemaVersion": {
          "description": "The version of the published format of its files.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "sourceSeq": {
          "description": "The project's operation sequence as of the draft that it was built from.",
          "format": "int64",
          "minimum": 0,
          "type": "integer"
        },
        "validationReport": {
          "description": "The validation report that its build stored."
        },
        "version": {
          "description": "Its version.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "note",
        "schemaVersion",
        "contentHash",
        "sourceSeq",
        "counts",
        "validationReport",
        "publishedAt",
        "builtAt",
        "path"
      ],
      "type": "object"
    },
    "RichTextAttributeId": {
      "description": "A component type's attribute definition's ID.",
      "pattern": "^[Aa][Tt][Rr]_[01234567][0123456789AaBbCcDdEeFfGgHhJjKkMmNnPpQqRrSsTtVvWwXxYyZz]{25}$",
      "type": "string"
    },
    "RichTextBlock": {
      "oneOf": [
        {
          "$ref": "#/$defs/RichTextParagraph"
        },
        {
          "$ref": "#/$defs/RichTextList"
        }
      ]
    },
    "RichTextBold": {
      "additionalProperties": false,
      "description": "Bold.",
      "properties": {
        "type": {
          "const": "bold"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextCode": {
      "additionalProperties": false,
      "description": "Inline code.",
      "properties": {
        "type": {
          "const": "code"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextComponentId": {
      "description": "A component's ID.",
      "pattern": "^[Cc][Mm][Pp]_[01234567][0123456789AaBbCcDdEeFfGgHhJjKkMmNnPpQqRrSsTtVvWwXxYyZz]{25}$",
      "type": "string"
    },
    "RichTextDecimals": {
      "description": "The number of digits after the point that a number is shown with, rounded half away from zero. A value that is not a number is shown as it is.",
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "RichTextDoc": {
      "additionalProperties": false,
      "description": "A document: its blocks, at least one. The editor's empty document is one empty paragraph.",
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/RichTextBlock"
          },
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "doc"
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "RichTextHardBreak": {
      "additionalProperties": false,
      "description": "A line break within a paragraph.",
      "properties": {
        "marks": {
          "$ref": "#/$defs/RichTextMarks"
        },
        "type": {
          "const": "hardBreak"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextInline": {
      "oneOf": [
        {
          "$ref": "#/$defs/RichTextText"
        },
        {
          "$ref": "#/$defs/RichTextHardBreak"
        },
        {
          "$ref": "#/$defs/RichTextMention"
        },
        {
          "$ref": "#/$defs/RichTextMemberMention"
        },
        {
          "$ref": "#/$defs/RichTextValueRef"
        }
      ]
    },
    "RichTextItalic": {
      "additionalProperties": false,
      "description": "Italic.",
      "properties": {
        "type": {
          "const": "italic"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextLink": {
      "additionalProperties": false,
      "description": "A link to an absolute http or https URL with a host, without white space, or a mailto URL of one address and nothing else.",
      "properties": {
        "attrs": {
          "additionalProperties": false,
          "properties": {
            "href": {
              "maxLength": 2048,
              "minLength": 1,
              "pattern": "^(?:[Hh][Tt][Tt][Pp][Ss]?://[^\\x00-\\x20\\x7f-\\x9f/?#][^\\x00-\\x20\\x7f-\\x9f]*|[Mm][Aa][Ii][Ll][Tt][Oo]:[A-Za-z0-9_+-]+(?:\\.[A-Za-z0-9_+-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\\.)*(?:[0-9]*[A-Za-z](?:[A-Za-z0-9-]*[A-Za-z0-9])?|[0-9]+-[A-Za-z0-9-]*[A-Za-z0-9]))$",
              "type": "string"
            }
          },
          "required": [
            "href"
          ],
          "type": "object"
        },
        "type": {
          "const": "link"
        }
      },
      "required": [
        "attrs",
        "type"
      ],
      "type": "object"
    },
    "RichTextList": {
      "additionalProperties": false,
      "description": "A list, bulleted (bulletList) or numbered (orderedList), of at least one item. Lists nest at most 5 deep, which the server checks beyond this schema.",
      "properties": {
        "attrs": {
          "additionalProperties": false,
          "description": "An orderedList's attributes. A bulletList has none, which the server checks beyond this schema.",
          "properties": {
            "start": {
              "description": "The number of the first item, 1 when it is not given.",
              "maximum": 999999,
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "content": {
          "items": {
            "$ref": "#/$defs/RichTextListItem"
          },
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "enum": [
            "bulletList",
            "orderedList"
          ]
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "RichTextListItem": {
      "additionalProperties": false,
      "description": "A list item: a paragraph, then any paragraphs and lists. That it starts with a paragraph is checked by the server, beyond this schema.",
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/RichTextBlock"
          },
          "minItems": 1,
          "type": "array"
        },
        "type": {
          "const": "listItem"
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "RichTextMarks": {
      "description": "The marks of an inline node, each at most once, which the server checks beyond this schema. The code mark is not combined with another.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/RichTextBold"
          },
          {
            "$ref": "#/$defs/RichTextCode"
          },
          {
            "$ref": "#/$defs/RichTextItalic"
          },
          {
            "$ref": "#/$defs/RichTextLink"
          },
          {
            "$ref": "#/$defs/RichTextStrike"
          }
        ]
      },
      "maxItems": 5,
      "type": "array"
    },
    "RichTextMemberMention": {
      "additionalProperties": false,
      "description": "A mention of a member of the project, a user who reads it, which a client shows as @ and the member's display name, and which tells the member of the comment. Only a comment's body holds one, which the server checks beyond this schema, and nothing is derived of it: it is no word of the text.",
      "properties": {
        "attrs": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/RichTextUserId"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "marks": {
          "$ref": "#/$defs/RichTextMarks"
        },
        "type": {
          "const": "memberMention"
        }
      },
      "required": [
        "attrs",
        "type"
      ],
      "type": "object"
    },
    "RichTextMention": {
      "additionalProperties": false,
      "description": "A mention of a component, which the text shows by the component's name.",
      "properties": {
        "attrs": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/RichTextComponentId"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "marks": {
          "$ref": "#/$defs/RichTextMarks"
        },
        "type": {
          "const": "mention"
        }
      },
      "required": [
        "attrs",
        "type"
      ],
      "type": "object"
    },
    "RichTextParagraph": {
      "additionalProperties": false,
      "description": "A paragraph, which may be empty.",
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/RichTextInline"
          },
          "type": "array"
        },
        "type": {
          "const": "paragraph"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextStrike": {
      "additionalProperties": false,
      "description": "Strikethrough.",
      "properties": {
        "type": {
          "const": "strike"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "RichTextText": {
      "additionalProperties": false,
      "description": "Text, without control characters but tabs, or line and paragraph separators: a line break is a hardBreak, and a paragraph a paragraph. Nor does it hold bidirectional controls, as U+202E, which the server checks beyond this schema. A document's texts hold at most 100,000 characters together.",
      "properties": {
        "marks": {
          "$ref": "#/$defs/RichTextMarks"
        },
        "text": {
          "minLength": 1,
          "pattern": "^[^\\x00-\\x08\\x0a-\\x1f\\x7f-\\x9f\u2028\u2029]+$",
          "type": "string"
        },
        "type": {
          "const": "text"
        }
      },
      "required": [
        "text",
        "type"
      ],
      "type": "object"
    },
    "RichTextUserId": {
      "description": "A user's ID.",
      "pattern": "^[Uu][Ss][Rr]_[01234567][0123456789AaBbCcDdEeFfGgHhJjKkMmNnPpQqRrSsTtVvWwXxYyZz]{25}$",
      "type": "string"
    },
    "RichTextValueRef": {
      "additionalProperties": false,
      "description": "A reference to a value, which the text shows as the runtime renders it: a variable's, or a runtime attribute's of a component.",
      "properties": {
        "attrs": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "decimals": {
                  "$ref": "#/$defs/RichTextDecimals"
                },
                "ref": {
                  "$ref": "#/$defs/RichTextVariableId"
                }
              },
              "required": [
                "ref"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "attribute": {
                  "$ref": "#/$defs/RichTextAttributeId"
                },
                "decimals": {
                  "$ref": "#/$defs/RichTextDecimals"
                },
                "ref": {
                  "$ref": "#/$defs/RichTextComponentId"
                }
              },
              "required": [
                "attribute",
                "ref"
              ],
              "type": "object"
            }
          ]
        },
        "marks": {
          "$ref": "#/$defs/RichTextMarks"
        },
        "type": {
          "const": "valueRef"
        }
      },
      "required": [
        "attrs",
        "type"
      ],
      "type": "object"
    },
    "RichTextVariableId": {
      "description": "A variable's ID.",
      "pattern": "^[Vv][Aa][Rr]_[01234567][0123456789AaBbCcDdEeFfGgHhJjKkMmNnPpQqRrSsTtVvWwXxYyZz]{25}$",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "contentHash": {
          "description": "The release's content hash.",
          "type": "string"
        },
        "kind": {
          "description": "draft for the project's draft, under draft/, or release for one of its releases, whose files are under release/.",
          "enum": [
            "draft",
            "release"
          ],
          "type": "string"
        },
        "snapshotId": {
          "description": "The release's ID.",
          "type": "string"
        },
        "version": {
          "description": "The release's version.",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ValidationMute": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "The finding's code.",
          "type": "string"
        },
        "mutedBy": {
          "description": "The user who muted it last, of a full archive alone, whom people.json names.",
          "type": "string"
        },
        "ownerId": {
          "description": "That entity.",
          "type": "string"
        },
        "ownerType": {
          "description": "The kind of entity that the finding is about.",
          "enum": [
            "node",
            "connection",
            "branch_output",
            "variable",
            "board"
          ],
          "type": "string"
        },
        "reason": {
          "description": "Why it is muted.",
          "type": "string"
        }
      },
      "required": [
        "ownerType",
        "ownerId",
        "code",
        "reason"
      ],
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "boardId": {
          "description": "The board of a board's variable.",
          "type": "string"
        },
        "default": {
          "description": "Its default value, of its type."
        },
        "description": {
          "description": "Its description.",
          "type": "string"
        },
        "folderId": {
          "description": "Its folder, if any.",
          "type": "string"
        },
        "id": {
          "description": "The variable's ID.",
          "type": "string"
        },
        "key": {
          "description": "The key that expressions name it by.",
          "type": "string"
        },
        "order": {
          "description": "Its order among its folder's children.",
          "type": "string"
        },
        "resetOnEnter": {
          "description": "Whether entering its board resets it.",
          "type": "boolean"
        },
        "scope": {
          "description": "global, or board.",
          "type": "string"
        },
        "type": {
          "description": "Its type.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "scope",
        "order",
        "key",
        "type",
        "default",
        "description",
        "resetOnEnter"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/CyberCute-Studio/storycreep/main/schema/authoring/v1/archive.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The JSON files of an authoring export of a Storycreep project (PRD FR-DATA-01), by their paths in its zip. authoring.json says which sections the archive holds. schema/authoring/README.md describes the format.",
  "properties": {
    "annotations.json": {
      "$ref": "#/$defs/ItemsAnnotation"
    },
    "assets/index.json": {
      "$ref": "#/$defs/ItemsAsset"
    },
    "authoring.json": {
      "$ref": "#/$defs/Manifest"
    },
    "comments.json": {
      "$ref": "#/$defs/ItemsComment"
    },
    "draft/boards.json": {
      "$ref": "#/$defs/ItemsBoard"
    },
    "draft/branch_outputs.json": {
      "$ref": "#/$defs/ItemsBranchOutput"
    },
    "draft/component_types.json": {
      "$ref": "#/$defs/ItemsComponentType"
    },
    "draft/components.json": {
      "$ref": "#/$defs/ItemsComponent"
    },
    "draft/connections.json": {
      "$ref": "#/$defs/ItemsConnection"
    },
    "draft/expressions.json": {
      "$ref": "#/$defs/ItemsExpression"
    },
    "draft/folders.json": {
      "$ref": "#/$defs/ItemsFolder"
    },
    "draft/nodes.json": {
      "$ref": "#/$defs/ItemsNode"
    },
    "draft/project.json": {
      "$ref": "#/$defs/Project"
    },
    "draft/validation_mutes.json": {
      "$ref": "#/$defs/ItemsValidationMute"
    },
    "draft/variables.json": {
      "$ref": "#/$defs/ItemsVariable"
    },
    "people.json": {
      "$ref": "#/$defs/ItemsPerson"
    },
    "play_states.json": {
      "$ref": "#/$defs/ItemsPlayState"
    },
    "releases/index.json": {
      "$ref": "#/$defs/ItemsRelease"
    }
  },
  "required": [
    "authoring.json"
  ],
  "title": "Storycreep authoring export, version 1",
  "type": "object"
}
